# Copia este archivo como .env y rellena lo que falta.

# --- Tú ---
MI_TELEFONO=+51XXXXXXXXX
GOOGLE_CALENDAR_ID=tu_correo@gmail.com

# --- IA para buscar e investigar eventos: basta UNA de estas keys ---
# gemini | openai | anthropic  (vacío = usa la primera key que encuentre)
PROVEEDOR_IA=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- LiveKit Cloud (Settings > API Keys) ---
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Twilio (llamadas + WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Opcional: si ya tienes un número de Twilio. Si no, el script compra uno.
TWILIO_NUMERO=
# Lo escribe solo: python scripts/configurar_telefonia.py
SIP_OUTBOUND_TRUNK_ID=

# WhatsApp: número del sandbox de Twilio (demo)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Solo en producción (plantilla aprobada por Meta)
# WHATSAPP_CONTENT_SID=

# --- Google Calendar (OPCIONAL: sin esto, te llega un link para agregarlo con un toque) ---
GOOGLE_SERVICE_ACCOUNT_FILE=credenciales/google-sa.json

# --- Ajustes (opcionales) ---
UMBRAL_IMPORTANCIA=80
MAX_EVENTOS_POR_LLAMADA=3
DIAS_ADELANTE=45
# MODELO_INVESTIGADOR=   (opcional; por defecto gemini-2.5-flash / gpt-5-mini / claude-haiku-5-5)
AGENT_NAME=chasqui
STT_VOZ=deepgram/nova-3
LLM_VOZ=openai/gpt-4.1-mini
TTS_VOZ=cartesia/sonic-3:5c5ad5e7-1020-476b-8b91-fdcbe9cc313c
